# --- Secrets. Never commit. ---
.env
.env.*
!.env.example
*.key
*.token
credentials*.json

# --- Private brand knowledge ---
# The repository is PUBLIC. Card contents and customer data stay out of it.
brands/*/knowledge/
brands/*/private/

# --- Working files ---
# rounds/ IS tracked on purpose: it is marketing copy destined to be public
# anyway, and keeping it in git gives a record of what was approved and when.
node_modules/
.DS_Store
*.log

# The hand-off package is rebuilt from the round on demand - no need to
# carry another copy of every image in git.
rounds/*/*/BeforeIDo-*/
rounds/*/*/BeforeIDo-*.zip
# download.zip IS tracked - it is what the app serves to whoever posts.
!rounds/*/*/download.zip
