# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Metricool - from Account Settings > API in metricool.com
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Safety switch. "dry" builds and previews without scheduling anything.
# Only "live" will actually schedule. Default stays "dry".
PUBLISH_MODE=dry
